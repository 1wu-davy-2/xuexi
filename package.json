{
  "name": "ck-sprint",
  "private": true,
  "version": "1.0.0",
  "description": "江苏成人高考专升本（理工类）冲刺复习系统：政治 / 英语 / 高等数学（一）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/server.mjs",
    "start": "node server/server.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/e2e.mjs",
    "test:data": "node scripts/validate-data.mjs && node scripts/validate-options.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.11.9",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "katex": "^0.16.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "puppeteer-core": "^25.10.0",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.3",
    "vite": "^5.4.10"
  }
}
